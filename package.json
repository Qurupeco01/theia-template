  "repository": {
    "type": "git",
    "url": "git+https://TODO.git"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "lerna": "^8.1.8"
  },
  "scripts": {
    "build:browser": "npm --prefix browser-app run bundle",
    "build:electron": "npm --prefix electron-app run bundle",
    "download:plugins": "theia download:plugins",
    "prepare": "lerna run prepare && npm run download:plugins",
    "postinstall": "theia check:theia-version && npm run prepare",
    "start:browser": "npm --prefix browser-app start",
    "start:electron": "npm --prefix electron-app start",
    "watch:browser": "lerna run --parallel watch --ignore electron-app",
    "watch:electron": "lerna run --parallel watch --ignore browser-app",
    "clean:browser:settings": "./scripts/clean.sh browser:settings",
    "clean:electron:settings": "./scripts/clean.sh electron:settings",
    "clean:electron:persistent": "./scripts/clean.sh electron:persistent",
    "clean:electron:fresh": "npm run clean:electron:settings && npm run clean:electron:persistent",
    "clean:build": "./scripts/clean.sh build:clean",
    "clean:analyze": "./scripts/clean.sh analyze"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    
  },
  "theiaPluginsExcludeIds":[

  ],
  "workspaces": [
    "browser-app", "electron-app", "extensions/*"
  ],
  "overrides": {
    "electron": "37.3.1",
    "tmp": "0.2.4"
  }
}