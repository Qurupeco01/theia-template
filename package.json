{
  "private": true,
  "version": "0.0.0",
  "license": "TODO",
  "author": "TODO",
  "homepage": "TODO",
  "bugs": {
    "url": "https://TODO/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://TODO.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "lerna": "^8.1.8",
    "rimraf": "^6.0.1"
  },
  "scripts": {
    "browser": "yarn workspace browser-app run",
    "electron": "yarn workspace electron-app run",
    "build": "yarn run build:prepare && yarn run build:applications",
    "build:dev": "yarn run build:prepare && yarn run build:applications:dev",
    "build:fresh": "yarn run clean:build && yarn run build",
    "build:fresh:dev": "yarn run clean:build && yarn run build:dev",
    "build:prepare": "yarn run build:extensions && yarn run download:plugins",
    "build:applications": "lerna run build --scope browser-app --scope electron-app --stream --concurrency 1",
    "build:applications:dev": "lerna run build:dev --scope browser-app --scope electron-app --parallel --stream",
    "build:extensions": "lerna run build --scope 'extensions/*' --stream",
    "rebuild": "lerna run rebuild --scope browser-app --scope electron-app --stream",
    "watch": "lerna run watch --scope browser-app --scope electron-app --parallel --stream",
    "watch:extensions": "lerna run watch --scope 'extensions/*' --parallel --stream",
    "test": "lerna run test --scope browser-app --scope electron-app --stream",
    "test:extensions": "lerna run test --scope 'extensions/*' --stream",
    "lint": "lerna run lint --scope browser-app --scope electron-app --stream",
    "lint:fix": "lerna run lint:fix --scope browser-app --scope electron-app --stream",
    "lint:extensions": "lerna run lint --scope 'extensions/*' --stream",
    "lint:extensions:fix": "lerna run lint:fix --scope 'extensions/*' --stream",
    "download:plugins": "theia download:plugins",
    "prepare": "theia check:theia-version && lerna run prepare",
    "clean": "yarn run clean:build && yarn run clean:deps",
    "clean:build": "lerna run clean --scope browser-app --scope electron-app --scope 'extensions/*' --stream && yarn run clean:plugins",
    "clean:deps": "rimraf node_modules",
    "clean:plugins": "rimraf plugins",
    "clean:browser:settings": "./scripts/clean.sh browser:settings",
    "clean:electron:settings": "./scripts/clean.sh electron:settings",
    "clean:electron:persistent": "./scripts/clean.sh electron:persistent",
    "clean:electron:fresh": "yarn run clean:electron:settings && yarn run clean:electron:persistent",
    "clean:analyze": "./scripts/clean.sh analyze"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    
  },
  "theiaPluginsExcludeIds":[

  ],
  "workspaces": [
    "browser-app",
    "electron-app",
    "extensions/*"
  ],
  "resolutions": {

  }
}